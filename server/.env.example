# ─────────────────────────────────────────────────────────────────────────────
# AION2 관제 대시보드 — 환경변수 예시
#
#   ★값은 하나도 안 적혀 있다★ — 실제 값은 Railway → Variables 에 넣는다.
#   이 파일은 「무슨 키가 있는지」만 알려준다. 절대 실값을 채워 커밋하지 말 것.
#   `railway.toml` 주석과 `server/main.py` 의 os.getenv 호출이 정본이다.
# ─────────────────────────────────────────────────────────────────────────────

# ── 필수 ─────────────────────────────────────────────────────────────────────
# 대시보드 로그인 비번(사람). 세션 쿠키 `session`, 유효 7일.
DASHBOARD_PASSWORD=
# 매크로·업데이터가 헤더 X-Api-Key 로 쓰는 키. ★공개 exe 에 각인되므로 유출 전제★
API_KEY=
# 세션 토큰 서명용 비밀. 바꾸면 로그인된 사람이 전부 튕긴다.
SESSION_SECRET=

# ── 저장 경로 (Railway Volume 을 /data 에 마운트했을 때) ──────────────────────
#   ★경로가 /data 라고 볼륨인 게 아니다★ — /health 의 disk_persisted 로 확인할 것.
DB_PATH=/data/macro_control.db
BUGS_DIR=/data/bugs
SCREENSHOTS_DIR=/data/screenshots
TTS_DIR=/data/tts

# ── FarmView 연동 API (/api/fv/*) ★2026-09-08 신설★ ──────────────────────────
#   ★비워두면 /api/fv/* 전체가 404 로 숨는다★ (기능이 꺼진 게 아니라 존재 자체가 안 보인다)
#   헤더 X-FV-Token 과 상수시간 비교한다. 세션·쿠키·429 락아웃을 전부 우회하므로
#   ★대시보드 비번과 반드시 다른 값★ 으로, 길게(32바이트 hex 권장) 만들 것.
#     만들기:  python -c "import secrets; print(secrets.token_hex(32))"
FV_TOKEN=
#   어느 테넌트 데이터를 줄지. 혼자 쓰면 비워둔다(기본 main).
FV_TENANT=

# ── 텔레그램 (단일 봇 중계) — 없으면 중계가 그냥 꺼진다 ──────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 답장 없이 코드만 왔을 때 「직전 요청 것」으로 추론하는 유효시간(초). 기본 1800
TELEGRAM_REPLY_WINDOW=

# ── 음성(TTS, edge-tts) ──────────────────────────────────────────────────────
TTS_VOICE=
TTS_RATE=
TTS_PITCH=

# ── 멀티테넌트 / 렌탈 (혼자 쓰면 안 건드린다) ────────────────────────────────
#   테넌트 정의 JSON. 비번→테넌트, API 키→테넌트 표를 여기서 읽는다.
TENANTS_JSON=
#   렌탈 exe ↔ 서버 라이선스 응답 서명용 공유 비밀(exe 에도 같은 값이 각인된다)
LICENSE_SECRET=

# ── 플랫폼이 넣어준다 (직접 넣지 않는다) ─────────────────────────────────────
# PORT=
